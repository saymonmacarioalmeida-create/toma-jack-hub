-- (os nomes Ciano/Magenta são antigos: agora são o vermelho e o laranja-sangue)
local T = {
    Fundo = Color3.fromRGB(6, 4, 4),
    Painel = Color3.fromRGB(13, 7, 7),
    Elemento = Color3.fromRGB(21, 10, 10),
    Hover = Color3.fromRGB(42, 13, 13),
    Ciano = Color3.fromRGB(255, 30, 30),
    Magenta = Color3.fromRGB(255, 95, 0),
    Texto = Color3.fromRGB(245, 236, 236),
    Dim = Color3.fromRGB(160, 118, 118),
    Off = Color3.fromRGB(52, 28, 28),
    -- fonte das opções (troque aqui: GothamBold, GothamBlack, SourceSansBold, Michroma, Bangers...)
    Fonte = Enum.Font.GothamBold,
    TamanhoTexto = 13,
}

local function criar(classe, props, parent)
    local obj = Instance.new(classe)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function cantos(obj, px)
    -- cantos quase retos: o raio pedido vira ~1/3
    return criar("UICorner", { CornerRadius = UDim.new(0, math.floor((px or 8) * 0.35)) }, obj)
end

local function borda(obj, cor, transp, espessura)
    return criar("UIStroke", {
        Color = cor or T.Ciano,
        Transparency = transp or 0.5,
        Thickness = espessura or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, obj)
end

local function neon(parent, rotacao)
    return criar("UIGradient", {
        Color = ColorSequence.new(T.Ciano, T.Magenta),
        Rotation = rotacao or 0,
    }, parent)
end

local function tw(obj, tempo, props)
    TweenService:Create(obj, TweenInfo.new(tempo, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function texto(parent, props)
    local base = {
        BackgroundTransparency = 1,
        Font = T.Fonte,
        TextSize = T.TamanhoTexto,
        TextColor3 = T.Texto,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }
    for k, v in pairs(props) do base[k] = v end
    return criar("TextLabel", base, parent)
end

local function ehClique(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch
end

local function ehMovimento(i)
    return i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch
end

-- arrasta na horizontal e devolve a posição X do mouse/dedo
local function arrastavel(zona, aoMover)
    local ativo = false
    zona.InputBegan:Connect(function(i)
        if ehClique(i) then
            ativo = true
            aoMover(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if ativo and ehMovimento(i) then
            aoMover(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if ehClique(i) then ativo = false end
    end)
end

