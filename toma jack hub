local function getInfo(p)
    local char = p.Character
    if not char then
        return nil
    end

    local info = infos[p]
    if not info then
        info = { proxCheck = 0 }
        infos[p] = info
    end

    if info.char ~= char then
        info.char = char
        info.hum = nil
        info.cabeca = nil
        info.tronco = nil
        info.pctInt = nil
        info.proxCheck = 0
    end

    local invalido = not info.tronco or not info.cabeca
        or not info.tronco.Parent or not info.cabeca.Parent
    if invalido and os.clock() >= info.proxCheck then
        info.proxCheck = os.clock() + 0.5
        info.hum = char:FindFirstChildOfClass("Humanoid")
        info.tronco = char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("HumanoidRootPart")
            or char.PrimaryPart
            or char:FindFirstChildWhichIsA("BasePart")
        -- personagens custom de RP: se não tiver "Head", mira no tronco
        info.cabeca = char:FindFirstChild("Head") or info.tronco
    end

    return info
end

-- ================= RAYCAST (reutilizado) =================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Vê se há parede entre a câmera e a parte. Partes transparentes ou sem colisão
-- (vidro, grades, efeitos, hitboxes invisíveis) são ignoradas, porque de longe
-- elas costumavam bloquear o aimlock sem ser uma parede de verdade.
local function temVisao(parte, char)
    if not Config.WallCheck then return true end

    local meuChar = player.Character
    local filtro = meuChar and { meuChar } or {}

    local origem = camera.CFrame.Position
    local direcao = parte.Position - origem

    for _ = 1, 5 do
        rayParams.FilterDescendantsInstances = filtro
        local r = Workspace:Raycast(origem, direcao, rayParams)
        if not r then return true end

        local alvo = r.Instance
        if alvo:IsDescendantOf(char) then return true end

        local pai = alvo.Parent
        local ehPessoa = pai and (pai:FindFirstChildOfClass("Humanoid")
            or (pai.Parent and pai.Parent:FindFirstChildOfClass("Humanoid")))
        if ehPessoa or alvo.Transparency >= 0.9 or not alvo.CanCollide then
            filtro[#filtro + 1] = alvo -- não é parede: ignora e continua
        else
            return false
        end
    end
    return false
end

-- ================= AIM LOCK =================
local bloqueados = {}

local function acharAlvo()
    local centro = UserInputService:GetMouseLocation()
    local camPos = camera.CFrame.Position
    table.clear(bloqueados)

    for _ = 1, 4 do
        local melhorParte, melhorChar
        local melhorNota = 1 -- nota = distância até a mira / FOV permitido (menor é melhor, 1 = borda)

        for _, outro in ipairs(jogadores) do
            local info = getInfo(outro)
            -- parte que vai ser mirada: cabeça ou tronco
            local parte = info and ((Config.AlvoParte == "Cabeça" and info.cabeca) or info.tronco)
            if info and parte and parte.Parent
                and (not info.hum or info.hum.Health > 0)
                and not bloqueados[parte]
                and not (Config.TeamCheck and outro.Team ~= nil and outro.Team == player.Team)
            then
                local distMundo = (parte.Position - camPos).Magnitude
                if distMundo <= Config.AlcanceMax then
                    local pos, naTela = camera:WorldToViewportPoint(parte.Position)
                    if naTela and pos.Z > 0 then
                        -- quem está longe fica pequeno na tela: aceita um FOV até 2x maior
                        local limite = Config.FOV
                        if Config.FOVDinamico then
                            limite = limite * (1 + math.min(distMundo / 400, 1))
                        end

                        local dx, dy = pos.X - centro.X, pos.Y - centro.Y
                        local nota = math.sqrt(dx * dx + dy * dy) / limite
                        if nota < melhorNota then
                            melhorNota = nota
                            melhorParte = parte
                            melhorChar = info.char
                        end
                    end
                end
            end
        end

        if not melhorParte then
            return nil
        end
        if temVisao(melhorParte, melhorChar) then
            return melhorParte
        end
        bloqueados[melhorParte] = true
    end

    return nil
end

local PRIORIDADE_AIM = Enum.RenderPriority.Camera.Value + 1
local PRIORIDADE_ESTICAR = Enum.RenderPriority.Camera.Value + 2
local PRIORIDADE_VIDA = Enum.RenderPriority.Camera.Value + 3

local circuloVisivel = false

RunService:BindToRenderStep("AimLockTronco", Enum.RenderPriority.Last.Value, function()
    camera = Workspace.CurrentCamera

    if circulo then
        local mostrar = Config.Ligado and Config.MostrarFOV
        if mostrar then
            circulo.Radius = Config.FOV
            circulo.Position = UserInputService:GetMouseLocation()
            circulo.Visible = true
            circuloVisivel = true
        elseif circuloVisivel then
            circulo.Visible = false
            circuloVisivel = false
        end
    end

    if not Config.Ligado then return end

    if Config.SoSegurando and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        return
    end

    local alvo = acharAlvo()
    if alvo then
        local alvoCFrame = CFrame.new(camera.CFrame.Position, alvo.Position)
        camera.CFrame = camera.CFrame:Lerp(alvoCFrame, Config.Suavidade)
    end
end)

-- ================= CHAMS (JOGADORES PINTADOS) =================
local chamsPasta = Instance.new("Folder")
chamsPasta.Name = "TomajackChams"
do
    local ok = pcall(function()
        chamsPasta.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    end)
    if not ok or not chamsPasta.Parent then
        chamsPasta.Parent = player:WaitForChild("PlayerGui")
    end
end

local chams = {}

local function esconderChams(p)
    local h = chams[p]
    if h then
        h.Enabled = false
    end
end

local function removerChams(p)
    local h = chams[p]
    if h then
        pcall(function() h:Destroy() end)
        chams[p] = nil
    end
end

local function atualizarChams(p)
    local char = p.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    local deveMostrar = Config.Chams
        and char ~= nil
        and char.Parent ~= nil
        and hum ~= nil
        and hum.Health > 0
        and not (Config.ChamsIgnorarTime and p.Team ~= nil and p.Team == player.Team)

    if not deveMostrar then
        esconderChams(p)
        return
    end

    local h = chams[p]
    if not h or not h.Parent then
        h = Instance.new("Highlight")
        h.Name = "Chams_" .. p.Name
        h.Parent = chamsPasta
        chams[p] = h
    end

    if h.Adornee ~= char then
        h.Adornee = char
    end

    h.FillColor = Config.ChamsCor
    h.OutlineColor = Config.ChamsCor
    h.FillTransparency = Config.ChamsPreenchimento
    h.OutlineTransparency = Config.ChamsContorno and 0 or 1
    h.DepthMode = Config.ChamsAtravesParede
        and Enum.HighlightDepthMode.AlwaysOnTop
        or Enum.HighlightDepthMode.Occluded
    h.Enabled = true
end

Conex[#Conex + 1] = Players.PlayerRemoving:Connect(function(p)
    removerChams(p)
    local info = infos[p]
    if info then
        if info.barraBorda then pcall(function() info.barraBorda:Remove() end) end
        if info.barraVida then pcall(function() info.barraVida:Remove() end) end
        if info.esp then
            for _, d in pairs(info.esp) do
                pcall(function() d:Remove() end)
            end
        end
    end
    infos[p] = nil
    task.defer(atualizarLista)
end)

local chamsEstavaLigado = false
task.spawn(function()
    while not hubFechado do
        if Config.Chams then
            chamsEstavaLigado = true
            for _, outro in ipairs(jogadores) do
                pcall(atualizarChams, outro)
            end
        elseif chamsEstavaLigado then
            for p in pairs(chams) do
                esconderChams(p)
            end
            chamsEstavaLigado = false
        end
        task.wait(0.2)
    end
end)

-- ================= BARRA DE VIDA EM CIMA DO NOME =================
local function novoQuadrado()
    local q = Drawing.new("Square")
    q.Filled = true
    q.Thickness = 1
    q.Transparency = 1
    q.Visible = false
    return q
end

local function esconderBarra(info)
    if info.barraVisivel then
        info.barraBorda.Visible = false
        info.barraVida.Visible = false
        info.barraVisivel = false
    end
end

local function paraTela(posicao)
    local ponto = camera:WorldToViewportPoint(posicao)
    if ponto.Z <= 0 then
        return nil
    end
    return Vector2.new(ponto.X, ponto.Y)
end

local function desenharBarra(outro, camPos)
    local info = getInfo(outro)
    if not info then
        local antigo = infos[outro]
        if antigo then esconderBarra(antigo) end
        return
    end

    local hum, cabeca, tronco = info.hum, info.cabeca, info.tronco
    if not (hum and cabeca and tronco and cabeca.Parent and tronco.Parent)
        or hum.Health <= 0
        or (Config.ChamsIgnorarTime and outro.Team ~= nil and outro.Team == player.Team)
        or (tronco.Position - camPos).Magnitude > Config.EspDistancia
    then
        esconderBarra(info)
        return
    end

    local topo = cabeca.Position + Vector3.new(0, Config.AlturaBarra, 0)
    local p1 = paraTela(topo)
    local p2 = paraTela(topo - Vector3.new(0, 1, 0))
    if not p1 or not p2 then
        esconderBarra(info)
        return
    end

    if not info.barraBorda then
        info.barraBorda = novoQuadrado()
        info.barraBorda.Color = Color3.fromRGB(0, 0, 0)
        info.barraBorda.Transparency = 0.6
        info.barraVida = novoQuadrado()
    end

    local pixelsPorStud = math.abs(p2.Y - p1.Y)
    local largura = math.clamp(pixelsPorStud * 3, 24, 120)
    local altura = math.clamp(pixelsPorStud * 0.35, 3, 8)
    local x = p1.X - largura / 2
    local y = p1.Y - altura / 2

    local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)

    info.barraBorda.Position = Vector2.new(x - 1, y - 1)
    info.barraBorda.Size = Vector2.new(largura + 2, altura + 2)

    info.barraVida.Position = Vector2.new(x, y)
    info.barraVida.Size = Vector2.new(largura * pct, altura)
    if info.ultimoPct ~= pct then
        info.ultimoPct = pct
        info.barraVida.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), pct)
    end

    info.barraBorda.Visible = true
    info.barraVida.Visible = true
    info.barraVisivel = true
end

local barraEstavaLigada = false

RunService:BindToRenderStep("VidaTomajack", PRIORIDADE_VIDA, function()
    if not temDrawing then return end

    if not Config.BarraVida then
        if barraEstavaLigada then
            for _, info in pairs(infos) do
                esconderBarra(info)
            end
            barraEstavaLigada = false
        end
        return
    end
    barraEstavaLigada = true

    camera = Workspace.CurrentCamera
    local camPos = camera.CFrame.Position

    for _, outro in ipairs(jogadores) do
        local ok = pcall(desenharBarra, outro, camPos)
        if not ok then
            local info = infos[outro]
            if info then pcall(esconderBarra, info) end
        end
    end
end)

-- ================= ESP (CAIXA, NOME, VIDA E DISTÂNCIA) =================
local PRETO = Color3.fromRGB(0, 0, 0)

local function novoTextoEsp(tamanho)
    local t = Drawing.new("Text")
    t.Size = tamanho
    t.Center = true
    t.Outline = true
    t.Transparency = 1
    t.Visible = false
    return t
end

local function novoQuadradoEsp(preenchido, espessura, cor)
    local q = Drawing.new("Square")
    q.Filled = preenchido
    q.Thickness = espessura
    q.Color = cor
    q.Transparency = 1
    q.Visible = false
    return q
end

local function criarEsp(info)
    info.esp = {
        sombra = novoQuadradoEsp(false, 3, PRETO),
        caixa = novoQuadradoEsp(false, 1, Color3.new(1, 1, 1)),
        nome = novoTextoEsp(14),
        dist = novoTextoEsp(13),
        vidaFundo = novoQuadradoEsp(true, 1, PRETO),
        vidaBarra = novoQuadradoEsp(true, 1, Color3.new(0, 1, 0)),
        vidaTexto = novoTextoEsp(12),
    }
    return info.esp
end

local function esconderEsp(info)
    if info.esp and info.espVisivel then
        for _, d in pairs(info.esp) do
            d.Visible = false
        end
        info.espVisivel = false
    end
end

local function desenharEsp(outro, camPos)
    local info = getInfo(outro)
    if not info then
        local antigo = infos[outro]
        if antigo then esconderEsp(antigo) end
        return
    end

    local hum, cabeca, tronco = info.hum, info.cabeca, info.tronco
    if not (hum and cabeca and tronco and cabeca.Parent and tronco.Parent)
        or hum.Health <= 0
        or (Config.EspSoInimigos and outro.Team ~= nil and outro.Team == player.Team)
        or (tronco.Position - camPos).Magnitude > Config.EspDistancia
    then
        esconderEsp(info)
        return
    end

    local raiz = info.raiz
    if not raiz or not raiz.Parent or info.raizChar ~= info.char then
        raiz = info.char:FindFirstChild("HumanoidRootPart") or tronco
        info.raiz = raiz
        info.raizChar = info.char
    end

    local topo = paraTela(cabeca.Position + Vector3.new(0, cabeca.Size.Y / 2 + 0.2, 0))
    local base = paraTela(raiz.Position - Vector3.new(0, 3, 0))
    if not topo or not base or base.Y - topo.Y < 4 then
        esconderEsp(info)
        return
    end

    local esp = info.esp or criarEsp(info)

    local altura = base.Y - topo.Y
    local largura = altura * 0.6
    local cx = topo.X
    local x, y = cx - largura / 2, topo.Y
    local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
    local corVida = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), pct)

    local mostrarCaixa = Config.EspCaixa
    esp.sombra.Visible = mostrarCaixa
    esp.caixa.Visible = mostrarCaixa
    if mostrarCaixa then
        esp.sombra.Position = Vector2.new(x, y)
        esp.sombra.Size = Vector2.new(largura, altura)
        esp.caixa.Position = Vector2.new(x, y)
        esp.caixa.Size = Vector2.new(largura, altura)
        esp.caixa.Color = Config.EspCor
    end

    esp.nome.Visible = Config.EspNome
    if Config.EspNome then
        esp.nome.Text = outro.DisplayName
        esp.nome.Color = Config.EspNomeCor
        esp.nome.Position = Vector2.new(cx, y - 17)
    end

    local mostrarVida = Config.EspVidaLado
    esp.vidaFundo.Visible = mostrarVida
    esp.vidaBarra.Visible = mostrarVida
    esp.vidaTexto.Visible = mostrarVida
    if mostrarVida then
        esp.vidaFundo.Position = Vector2.new(x - 6, y - 1)
        esp.vidaFundo.Size = Vector2.new(4, altura + 2)
        esp.vidaBarra.Position = Vector2.new(x - 5, y + altura * (1 - pct))
        esp.vidaBarra.Size = Vector2.new(2, altura * pct)
        esp.vidaBarra.Color = corVida
        esp.vidaTexto.Text = tostring(math.floor(pct * 100 + 0.5))
        esp.vidaTexto.Color = corVida
        esp.vidaTexto.Position = Vector2.new(x - 15, y - 7)
    end

    esp.dist.Visible = Config.EspDistTexto
    if Config.EspDistTexto then
        esp.dist.Text = math.floor((raiz.Position - camPos).Magnitude) .. "m"
        esp.dist.Color = Color3.new(1, 1, 1)
        esp.dist.Position = Vector2.new(cx, base.Y + 2)
    end

    info.espVisivel = true
end

