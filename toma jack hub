local ceu = { ativo = false, hora = 0, original = nil, skies = {}, sky = nil, atm = nil, atmCriada = false, atmOrig = nil }

local function restaurarCeu()
    ceu.ativo = false
    if ceu.sky then pcall(function() ceu.sky:Destroy() end) ceu.sky = nil end
    for _, sk in ipairs(ceu.skies) do
        pcall(function() sk.Parent = Lighting end)
    end
    ceu.skies = {}
    if ceu.atm then
        if ceu.atmCriada then
            pcall(function() ceu.atm:Destroy() end)
        elseif ceu.atmOrig then
            for k, v in pairs(ceu.atmOrig) do
                pcall(function() ceu.atm[k] = v end)
            end
        end
    end
    ceu.atm, ceu.atmCriada, ceu.atmOrig = nil, false, nil
    if ceu.original then
        for k, v in pairs(ceu.original) do
            pcall(function() Lighting[k] = v end)
        end
        ceu.original = nil
    end
end

local function aplicarCeu(indice)
    local c = CEUS[indice]
    if not c then
        restaurarCeu()
        return
    end

    if not ceu.original then
        ceu.original = {}
        for _, k in ipairs({ "ClockTime", "Ambient", "OutdoorAmbient", "ColorShift_Top", "ColorShift_Bottom" }) do
            pcall(function() ceu.original[k] = Lighting[k] end)
        end
    end

    -- esconde o céu do jogo (e põe de volta ao restaurar)
    if not ceu.sky then
        for _, o in ipairs(Lighting:GetChildren()) do
            if o:IsA("Sky") then
                ceu.skies[#ceu.skies + 1] = o
            end
        end
        for _, o in ipairs(ceu.skies) do
            o.Parent = nil
        end
        ceu.sky = Instance.new("Sky")
        ceu.sky.Name = "TomajackCeu"
        ceu.sky.Parent = Lighting
    end
    ceu.sky.StarCount = c.estrelas
    ceu.sky.CelestialBodiesShown = true
    ceu.sky.MoonAngularSize = 14
    ceu.sky.SunAngularSize = 22

    -- iluminação e horário
    ceu.hora = c.hora
    pcall(function()
        Lighting.ClockTime = c.hora
        Lighting.ColorShift_Top = c.topo
        Lighting.ColorShift_Bottom = c.base
        Lighting.Ambient = c.amb
        Lighting.OutdoorAmbient = c.amb
    end)

    -- névoa atmosférica colorida
    if not ceu.atm then
        local existente = Lighting:FindFirstChildOfClass("Atmosphere")
        if existente then
            ceu.atm = existente
            ceu.atmOrig = {
                Density = existente.Density, Offset = existente.Offset, Color = existente.Color,
                Decay = existente.Decay, Glare = existente.Glare, Haze = existente.Haze,
            }
        elseif c.atm then
            ceu.atm = Instance.new("Atmosphere")
            ceu.atm.Name = "TomajackCeuNevoa"
            ceu.atm.Parent = Lighting
            ceu.atmCriada = true
        end
    end
    if ceu.atm then
        if c.atm then
            ceu.atm.Color = c.atm[1]
            ceu.atm.Decay = c.atm[2]
            ceu.atm.Density = c.atm[3]
            ceu.atm.Haze = c.atm[4]
            ceu.atm.Offset = 0.25
            ceu.atm.Glare = 0
        else
            ceu.atm.Density = 0
        end
    end
    ceu.ativo = true
end

