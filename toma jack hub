-- ================= ANTI LAG =================
-- cria um módulo que aplica propriedades em objetos e depois restaura
local function criarAntiLag(containers, regras)
    local salvo = {}
    local conexoes = {}
    local ativo = false

    local function aplicar(obj)
        for _, r in ipairs(regras) do
            if obj:IsA(r.classe) then
                local orig = salvo[obj] or {}
                for k, v in pairs(r.props) do
                    if orig[k] == nil then
                        pcall(function() orig[k] = obj[k] end)
                    end
                    pcall(function() obj[k] = v end)
                end
                salvo[obj] = orig
            end
        end
    end

    return function(ligar)
        if ligar == ativo then return end
        ativo = ligar

        if ligar then
            for _, c in ipairs(containers) do
                conexoes[#conexoes + 1] = c.DescendantAdded:Connect(function(o)
                    if ativo then aplicar(o) end
                end)
                task.spawn(function()
                    local n = 0
                    for _, o in ipairs(c:GetDescendants()) do
                        if not ativo then return end
                        aplicar(o)
                        n += 1
                        if n % 400 == 0 then task.wait() end -- não trava o jogo
                    end
                end)
            end
        else
            for _, cn in ipairs(conexoes) do cn:Disconnect() end
            table.clear(conexoes)
            for obj, orig in pairs(salvo) do
                for k, v in pairs(orig) do
                    pcall(function() obj[k] = v end)
                end
            end
            table.clear(salvo)
        end
    end
end

