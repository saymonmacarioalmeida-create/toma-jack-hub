            local frac = (valor - minimo) / (maximo - minimo)
            preenche.Size = UDim2.fromScale(frac, 1)
            bola.Position = UDim2.fromScale(frac, 0.5)
            valorLabel.Text = tostring(math.floor(valor * 100 + 0.5) / 100) .. (sufixo or "")
        end
        mostrar()

        local zona = criar("TextButton", {
            Position = UDim2.fromOffset(0, 26),
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundTransparency = 1,
            Text = "",
        }, f)
        arrastavel(zona, function(x)
            local frac = math.clamp((x - trilho.AbsolutePosition.X) / math.max(trilho.AbsoluteSize.X, 1), 0, 1)
            local v = minimo + frac * (maximo - minimo)
            v = math.floor(v / incremento + 0.5) * incremento
            v = math.clamp(v, minimo, maximo)
            if v ~= valor then
                valor = v
                mostrar()
                cb(valor)
            end
        end)
    end

