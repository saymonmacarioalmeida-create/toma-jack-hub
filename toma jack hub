-- ---------- FUMAÇA COLORIDA AO ATIRAR ----------
-- Quando você segura o botão esquerdo com uma arma (Tool) na mão, sai fumaça colorida
-- da ponta da arma. É só visual: aparece na sua tela.
local fumacaAtt, fumacaEm, fumacaTool = nil, nil, nil
local acumuladorFumaca = 0

local function limparFumaca()
    if fumacaAtt then pcall(function() fumacaAtt:Destroy() end) end
    fumacaAtt, fumacaEm, fumacaTool = nil, nil, nil
end

local function pegarEmissor(tool)
    if fumacaEm and fumacaEm.Parent and fumacaTool == tool then
        return fumacaEm
    end
    limparFumaca()

    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
    if not handle then return nil end

    local att = Instance.new("Attachment")
    att.Name = "TomajackFumaca"
    att.Position = Vector3.new(0, 0, -handle.Size.Z / 2) -- ponta da arma (frente = -Z)
    att.Parent = handle

    local em = Instance.new("ParticleEmitter")
    em.Texture = "rbxasset://textures/particles/smoke_main.dds"
    em.Rate = 0
    em.Lifetime = NumberRange.new(0.6, 1.1)
    em.Speed = NumberRange.new(4, 8)
    em.SpreadAngle = Vector2.new(12, 12)
    em.EmissionDirection = Enum.NormalId.Front
    em.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.6),
        NumberSequenceKeypoint.new(1, 3),
    })
    em.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.3),
        NumberSequenceKeypoint.new(1, 1),
    })
    em.LightEmission = 0.6
    em.Drag = 2
    em.Rotation = NumberRange.new(0, 360)
    em.RotSpeed = NumberRange.new(-60, 60)
    em.Acceleration = Vector3.new(0, 1.5, 0)
    em.Parent = att

    fumacaAtt, fumacaEm, fumacaTool = att, em, tool
    return em
end

Conex[#Conex + 1] = RunService.Heartbeat:Connect(function(dt)
    if not Config.Fumaca then
        if fumacaAtt then limparFumaca() end
        return
    end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return end

    -- clicar dentro do menu não solta fumaça
    if menuAberto then
        local m = UserInputService:GetMouseLocation()
        local pos, tam = main.AbsolutePosition, main.AbsoluteSize
        if m.X >= pos.X and m.X <= pos.X + tam.X and m.Y >= pos.Y and m.Y <= pos.Y + tam.Y then
            return
        end
    end

    local char = player.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool then return end

    acumuladorFumaca += dt
    if acumuladorFumaca < 0.06 then return end
    acumuladorFumaca = 0

    local em = pegarEmissor(tool)
    if not em then return end

    local cor = Config.FumacaArcoIris and Color3.fromHSV((os.clock() * 0.6) % 1, 1, 1) or Config.FumacaCor
    em.Color = ColorSequence.new(cor)
    em:Emit(Config.FumacaQtd)
end)

-- ---------- fechar o hub por completo ----------
-- Desliga tudo, devolve o que foi alterado (anti lag, esticar tela), apaga os
-- desenhos e a janela. Depois disso o hub some até você executar o script de novo.
local function fecharHub()
    if hubFechado then return end
    hubFechado = true

    Config.Ligado = false
    Config.Chams = false
    Config.BarraVida = false
    Config.Esp = false
    Config.Esticar = false
    Config.CamFOVAtivo = false
    Config.Fumaca = false
    limparFumaca()
    Config.Shader = false
    removerShader()
    restaurarCeu()
    pcall(function() miraGui:Destroy() end)
    if camFovOriginal then
        pcall(function() Workspace.CurrentCamera.FieldOfView = camFovOriginal end)
        camFovOriginal = nil
    end

    for _, nome in ipairs({ "AimLockTronco", "VidaTomajack", "EspTomajack", "EsticarTomajack", "CamFovTomajack" }) do
        pcall(function() RunService:UnbindFromRenderStep(nome) end)
    end

    for _, c in ipairs(Conex) do
        pcall(function() c:Disconnect() end)
    end

    -- devolve o que o anti lag mudou
    pcall(antiLagEfeitos, false)
    pcall(antiLagTexturas, false)
    pcall(antiLagParticulas, false)
    pcall(antiLagSombras, false)
    pcall(antiLagQualidade, false)

    -- apaga desenhos
    if circulo then pcall(function() circulo:Remove() end) end
    for _, info in pairs(infos) do
        for _, k in ipairs({ "barraBorda", "barraVida" }) do
            if info[k] then pcall(function() info[k]:Remove() end) end
        end
        if info.esp then
            for _, d in pairs(info.esp) do
                pcall(function() d:Remove() end)
            end
        end
    end

    for p in pairs(chams) do
        removerChams(p)
    end
    pcall(function() chamsPasta:Destroy() end)
    pcall(function() gui:Destroy() end)

    if env.TomajackFechar == fecharHub then
        env.TomajackFechar = nil
    end
end

